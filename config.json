\n` + formatted;         }          async function fetchExistingConfig() {             try {                 const res = await fetch('./config.json?v=' + Date.now());                 if (res.ok) {                     const data = await res.json();                     if (data.bandName) document.getElementById('bandNameInput').value = data.bandName;                     if (data.members) document.getElementById('membersInput').value = data.members.join(', ');                     if (data.ugPlaylistUrl) document.getElementById('ugUrlInput').value = data.ugPlaylistUrl;                 }             } catch (e) {                 console.log('Using default config fields.');             }             updateJsonPreview();         }          function generateConfigBlock() {             const outputText = document.getElementById('jsonOutput').innerText;             navigator.clipboard.writeText(outputText).then(() => {                 alert('config.json blok kodu kopyalandı! update.yml iş akışına yapıştırabilirsiniz.');             }).catch(err => {                 console.error('Kopyalama başarısız:', err);             });         }          document.getElementById('bandNameInput').addEventListener('input', updateJsonPreview);         document.getElementById('membersInput').addEventListener('input', updateJsonPreview);         document.getElementById('ugUrlInput').addEventListener('input', updateJsonPreview);          fetchExistingConfig();     </script>      <script src="./js/setup.js?v=BUILD_SHA"></script>     <script src="./js/script.js?v=BUILD_SHA"></script> </body> </html>  